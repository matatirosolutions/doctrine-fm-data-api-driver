# Connection details for the functional tests. Copy this file to tests/Functional/.env.local (git-ignored), change
# FM_HOST to the server hosting tests/Functional/Database/DoctrineFMTest.fmp12, and the tests pick it up. Anything
# already exported in your shell takes precedence over the file.
# The account is the throw-away one built into the test database; change it on any server that is not private.
# FM_HOST to the server hosting tests/Functional/Database/DoctrineFMTest.fmp12.
# The account is the throw-away one built into the test database; change it on any server that is not private.
FM_HOST=your-fms.example.com
FM_PORT=443
FM_DBNAME=DoctrineFMTest
FM_USER=api_test
FM_PASSWORD=9af8240ca3c26bf7462fc746
# FMS for FileMaker Server, FMCloud for FileMaker Cloud (needs matatirosoln/fm-cloud-authentication)
FM_SERVER_VERSION=FMS
# Set to 0 for a local server with a self-signed certificate
FM_VERIFY_TLS=1
# The driver caps TLS at 1.2 unless told otherwise (see the README: max_tls_version). Set to 'none' to turn that off
FM_MAX_TLS_VERSION=
