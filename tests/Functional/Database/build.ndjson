{"op": "create:script", "name": "Echo Parameter ( json )", "body": [{"stepID": 89, "step": "#", "text": "Purpose: Return the script parameter inside a standard result object, so tests can prove parameters reach FileMaker."}, {"stepID": 89, "step": "#", "text": "Context: any layout"}, {"stepID": 89, "step": "#", "text": "Parameters: any text, passed through as a JSON string value"}, {"stepID": 89, "step": "#", "text": "Returns: JSON { errorCode, message, data } where data is the parameter"}, {"stepID": 89, "step": "#", "text": ""}, {"stepID": 85, "step": "Allow User Abort", "on": false}, {"stepID": 86, "step": "Set Error Capture", "on": true}, {"stepID": 141, "step": "Set Variable", "name": "$result", "value": "JSONSetElement ( \"{}\" ; [ \"errorCode\" ; 0 ; JSONNumber ] ; [ \"message\" ; \"\" ; JSONString ] ; [ \"data\" ; Get ( ScriptParameter ) ; JSONString ] )"}, {"stepID": 103, "step": "Exit Script", "result": "$result"}]}
