{
  "name": "matatirosoln/doctrine-fm-data-api-driver",
  "description": "Use FileMaker via the v17+ Data API as your backend database",
  "type": "library",
  "authors": [
    {
      "name": "Steve Winter",
      "email": "steve@msdev.co.uk"
    }
  ],
  "keywords": [
    "doctrine",
    "dbal",
    "FileMaker"
  ],
  "license": [
    "MIT"
  ],
  "require": {
    "php": ">=8.1.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "doctrine/dbal": "2.*|3.*",
    "doctrine/orm": "2.*",
    "greenlion/php-sql-parser": "^4.0",
    "guzzlehttp/guzzle": "^7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/cache": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "MSDev\\DoctrineFMDataAPIDriver\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MSDev\\DoctrineFMDataAPIDriver\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
